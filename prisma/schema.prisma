generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  PLAYING
  VICTORY
  DEFEAT
  ABANDONED
}

model GameSession {
  id              String                 @id @db.Uuid
  ownerTokenHash  String                 @map("owner_token_hash") @db.Char(64)
  title           String                 @db.VarChar(160)
  status          SessionStatus          @default(PLAYING)
  stateVersion    Int                    @default(1) @map("state_version")
  currentTurn     Int                    @default(0) @map("current_turn")
  currentSnapshot Json                   @map("current_snapshot")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  completedAt     DateTime?              @map("completed_at")
  abandonedAt     DateTime?              @map("abandoned_at")
  events          GameEvent[]
  activeRules     ActiveRule[]
  inventoryItems  SessionInventoryItem[]
  npcStates       SessionNpcState[]
  turnRequests    TurnRequest[]

  @@index([ownerTokenHash, updatedAt])
  @@map("game_sessions")
}

model GameEvent {
  id                  String      @id @default(uuid()) @db.Uuid
  sessionId           String      @map("session_id") @db.Uuid
  turn                Int
  eventId             String      @map("event_id") @db.VarChar(128)
  eventKind           String      @map("event_kind") @db.VarChar(32)
  title               String      @db.VarChar(240)
  actionId            String      @map("action_id") @db.VarChar(128)
  actionLabel         String      @map("action_label") @db.VarChar(320)
  beforeStateSnapshot Json        @map("before_state_snapshot")
  afterStateSnapshot  Json        @map("after_state_snapshot")
  effects             Json
  ruleEvents          Json        @map("rule_events")
  createdAt           DateTime    @default(now()) @map("created_at")
  session             GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turn])
  @@index([sessionId, createdAt])
  @@map("game_events")
}

model ActiveRule {
  id              String      @id @default(uuid()) @db.Uuid
  sessionId       String      @map("session_id") @db.Uuid
  ruleId          String      @map("rule_id") @db.VarChar(128)
  ruleKey         String      @map("rule_key") @db.VarChar(80)
  parameters      Json
  remainingTurns  Int         @map("remaining_turns")
  totalTurns      Int         @map("total_turns")
  activatedAtTurn Int         @map("activated_at_turn")
  session         GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, ruleId])
  @@map("active_rules")
}

model SessionInventoryItem {
  id            String      @id @default(uuid()) @db.Uuid
  sessionId     String      @map("session_id") @db.Uuid
  itemId        String      @map("item_id") @db.VarChar(128)
  name          String      @db.VarChar(160)
  description   String      @db.VarChar(2000)
  rarity        String      @db.VarChar(32)
  quantity      Int
  usesRemaining Int         @map("uses_remaining")
  snapshot      Json
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, itemId])
  @@map("session_inventory_items")
}

model SessionNpcState {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @map("session_id") @db.Uuid
  npcId        String      @map("npc_id") @db.VarChar(128)
  name         String      @db.VarChar(160)
  relationship Int
  snapshot     Json
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, npcId])
  @@map("session_npc_states")
}

model TurnRequest {
  id               String      @id @default(uuid()) @db.Uuid
  sessionId        String      @map("session_id") @db.Uuid
  idempotencyKey   String      @map("idempotency_key") @db.VarChar(128)
  expectedVersion  Int         @map("expected_version")
  resultingVersion Int         @map("resulting_version")
  action           Json
  responseSnapshot Json        @map("response_snapshot")
  createdAt        DateTime    @default(now()) @map("created_at")
  session          GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@map("turn_requests")
}
