# Configure these only in .env.local or encrypted server-side environment
# settings. Never expose credentials to the browser or commit real values.
DATABASE_URL=

# Use only an isolated non-production database. Never deploy this variable.
TEST_DATABASE_URL=

# Safe default. Set to gemini only after configuring both values below.
AI_PROVIDER_MODE=fallback
GEMINI_API_KEY=
GEMINI_MODEL=
