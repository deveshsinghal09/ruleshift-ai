{
  "name": "ruleshift-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/domain src/lib src/hooks",
    "test:components": "vitest run src/app src/components src/features/character src/features/game src/features/result",
    "test:contracts": "vitest run src/server/ai src/server/env.test.ts src/server/http src/features/adventure/http-transport.test.ts",
    "test:integration": "vitest run src/features/adventure src/server/game tests/configuration && npm run db:test",
    "pretest:e2e": "node scripts/run-test-migration.mjs && npm run build",
    "test:e2e": "node scripts/run-playwright-tests.mjs",
    "test:all": "npm test && npm run db:test && npm run test:e2e",
    "quality": "npm run typecheck && npm run lint && npm run test:all",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "node scripts/run-safe-migration.mjs",
    "db:migrate:test": "node scripts/run-test-migration.mjs",
    "db:test": "node scripts/run-database-tests.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.24",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
